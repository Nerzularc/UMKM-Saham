# =============================================================================
# UMKM Saham — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=umkm_user
DB_PASSWORD=umkm_dev_password
DB_NAME=umkm_saham
DATABASE_URL=postgresql://umkm_user:umkm_dev_password@localhost:5432/umkm_saham

# ── Session / JWT ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_FOR_PRODUCTION
JWT_SECRET=2dd0c322bda775bdd8e7ea51866b820e5376add6eae4f2c37b86a79c74d74b9195e15bb977a1c65399d0b83af91870b7
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Redis (optional — used for rate limiting and sessions) ───────────────────
REDIS_URL=redis://localhost:6379

# ── Market data provider (optional — app works in demo mode without these) ───
# Supported: alpha_vantage | polygon | demo
MARKET_DATA_PROVIDER=demo
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# ── Currency rates provider (optional) ───────────────────────────────────────
# Supported: exchangerate_api | open_exchange_rates | demo
CURRENCY_PROVIDER=demo
EXCHANGERATE_API_KEY=
OPEN_EXCHANGE_RATES_APP_ID=

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ── Email (optional — for password reset) ────────────────────────────────────
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@umkm-saham.local

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Application timezone ─────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Jakarta

# ── Demo mode flag ───────────────────────────────────────────────────────────
# When true, seed data is clearly labelled as demonstration data.
DEMO_MODE=true

TOTP_ENCRYPTION_KEY=9000ff92929e4bb3acda52932559eb217052cd424870756a02a82c331ac1e99a5cbd462df9a8b9d03c0cfd5a936e9b22
