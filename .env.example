# =============================================================================
# UMKM Saham — environment variables
# Copy to .env (or run `npm run setup`, which also generates the secrets).
# Never commit .env. Every external API key is optional: without them the app
# runs in clearly labelled demo mode.
# =============================================================================

NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind one reverse proxy (correct client IPs for rate limits/audit)
TRUST_PROXY=

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=umkm_user
DB_PASSWORD=umkm_dev_password
DB_NAME=umkm_saham
DATABASE_URL=postgresql://umkm_user:umkm_dev_password@localhost:5432/umkm_saham
# Test suite database (reset on every test run). Defaults to <DB_NAME>_test.
TEST_DATABASE_URL=postgresql://umkm_user:umkm_dev_password@localhost:5432/umkm_saham_test
DB_SSL=false

# ── Sessions & 2FA ────────────────────────────────────────────────────────────
# Long random values. `npm run setup` fills these in automatically.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
TOTP_ENCRYPTION_KEY=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET

# ── Market data (optional) ────────────────────────────────────────────────────
# demo | alpha_vantage
MARKET_DATA_PROVIDER=demo
ALPHA_VANTAGE_API_KEY=
# cron (Asia/Jakarta) for scheduled quote refresh when a live provider is set
MARKET_DATA_REFRESH_CRON=*/30 * * * 1-5
PROVIDER_TIMEOUT_MS=10000
# minimum gap between provider requests (free Alpha Vantage keys: ~5/min)
PROVIDER_MIN_INTERVAL_MS=15000

# ── Exchange rates (optional) ─────────────────────────────────────────────────
# demo | exchangerate_api
CURRENCY_PROVIDER=demo
EXCHANGERATE_API_KEY=

# ── Imports ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
MAX_IMPORT_ROWS=10000

# ── Operations ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Jakarta
# Background jobs (price/FX sync, session cleanup)
ENABLE_JOBS=true
API_RATE_LIMIT=1000
# Serve client/dist from the API when it exists (production-style single origin)
SERVE_CLIENT=true
BACKUP_DIR=backups
BACKUP_RETENTION=14

# ── Demo ──────────────────────────────────────────────────────────────────────
# Shows the DEMO DATA banner and labels. Seed data is always flagged as demo.
DEMO_MODE=true
VITE_DEMO_MODE=true
# Password for seeded demo accounts (development only)
DEMO_PASSWORD=Demo@1234
